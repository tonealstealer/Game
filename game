<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>GameZone | Mini Games</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- ================= HEADER ================= -->

    <header>

        <div class="logo">
            🎮 GameZone
        </div>

        <nav>
            <a href="#home">Home</a>
            <a href="#games">Games</a>
            <a href="#about">About</a>
        </nav>

    </header>


    <!-- ================= MAIN ================= -->

    <main>

        <!-- HERO SECTION -->

        <section id="home" class="hero">

            <div class="hero-content">

                <p class="badge">
                    🎮 MINI GAME HUB
                </p>

                <h1>
                    Play.<br>
                    <span>Compete.</span><br>
                    Have Fun.
                </h1>

                <p class="hero-text">
                    Welcome to GameZone — a collection of
                    quick and fun browser games.
                    No downloads required.
                </p>

                <a href="#games" class="play-button">
                    Start Playing →
                </a>

            </div>

            <div class="hero-game">
                🎮
            </div>

        </section>


        <!-- ================= GAMES ================= -->

        <section id="games" class="games-section">

            <div class="section-title">

                <p class="badge">
                    OUR GAMES
                </p>

                <h2>
                    Choose a Game
                </h2>

                <p>
                    Pick a game and start playing!
                </p>

            </div>


            <div class="game-grid">


                <!-- TIC TAC TOE -->

                <div class="game-card"
                     onclick="openGame('tictactoe')">

                    <div class="game-icon">
                        ⭕
                    </div>

                    <h3>
                        Tic-Tac-Toe
                    </h3>

                    <p>
                        Challenge yourself or play
                        against a friend.
                    </p>

                    <button>
                        Play Game
                    </button>

                </div>


                <!-- ROCK PAPER SCISSORS -->

                <div class="game-card"
                     onclick="openGame('rps')">

                    <div class="game-icon">
                        ✊
                    </div>

                    <h3>
                        Rock Paper Scissors
                    </h3>

                    <p>
                        Choose your move and
                        battle the computer.
                    </p>

                    <button>
                        Play Game
                    </button>

                </div>


                <!-- REACTION TEST -->

                <div class="game-card"
                     onclick="openGame('reaction')">

                    <div class="game-icon">
                        ⚡
                    </div>

                    <h3>
                        Reaction Test
                    </h3>

                    <p>
                        Test your reaction speed
                        and beat your record.
                    </p>

                    <button>
                        Play Game
                    </button>

                </div>


                <!-- NUMBER GUESS -->

                <div class="game-card"
                     onclick="openGame('guess')">

                    <div class="game-icon">
                        🔢
                    </div>

                    <h3>
                        Number Guess
                    </h3>

                    <p>
                        Guess the secret number
                        between 1 and 100.
                    </p>

                    <button>
                        Play Game
                    </button>

                </div>

            </div>

        </section>


        <!-- ================= GAME AREA ================= -->

        <section id="game-area" class="game-area hidden">

            <button
                class="back-button"
                onclick="closeGame()">

                ← Back to Games

            </button>


            <!-- ================= TIC TAC TOE ================= -->

            <div
                id="tictactoe"
                class="game-container hidden">

                <h2>
                    ⭕ Tic-Tac-Toe
                </h2>

                <p id="ttt-status">
                    Player X's turn
                </p>


                <div class="board">

                    <button onclick="tttMove(0)"></button>

                    <button onclick="tttMove(1)"></button>

                    <button onclick="tttMove(2)"></button>

                    <button onclick="tttMove(3)"></button>

                    <button onclick="tttMove(4)"></button>

                    <button onclick="tttMove(5)"></button>

                    <button onclick="tttMove(6)"></button>

                    <button onclick="tttMove(7)"></button>

                    <button onclick="tttMove(8)"></button>

                </div>


                <button
                    class="reset-button"
                    onclick="resetTTT()">

                    Reset Game

                </button>

            </div>


            <!-- ================= ROCK PAPER SCISSORS ================= -->

            <div
                id="rps"
                class="game-container hidden">

                <h2>
                    ✊ Rock Paper Scissors
                </h2>

                <p id="rps-result">
                    Choose your move!
                </p>


                <div class="rps-buttons">

                    <button
                        onclick="playRPS('rock')">

                        ✊ Rock

                    </button>

                    <button
                        onclick="playRPS('paper')">

                        ✋ Paper

                    </button>

                    <button
                        onclick="playRPS('scissors')">

                        ✌️ Scissors

                    </button>

                </div>


                <div class="score">

                    <div>

                        <strong id="player-score">
                            0
                        </strong>

                        <span>
                            You
                        </span>

                    </div>


                    <div>

                        <strong id="computer-score">
                            0
                        </strong>

                        <span>
                            Computer
                        </span>

                    </div>

                </div>


                <button
                    class="reset-button"
                    onclick="resetRPS()">

                    Reset Game

                </button>

            </div>


            <!-- ================= REACTION GAME ================= -->

            <div
                id="reaction"
                class="game-container hidden">

                <h2>
                    ⚡ Reaction Test
                </h2>

                <p id="reaction-text">
                    Click the box to start!
                </p>


                <div
                    id="reaction-box"
                    onclick="reactionClick()">

                    CLICK ME

                </div>


                <p class="best-score">

                    Best:
                    <span id="best-reaction">
                        --
                    </span>
                    ms

                </p>

            </div>


            <!-- ================= NUMBER GUESS ================= -->

            <div
                id="guess"
                class="game-container hidden">

                <h2>
                    🔢 Number Guess
                </h2>

                <p>
                    I'm thinking of a number
                    between 1 and 100.
                </p>


                <input
                    type="number"
                    id="guess-input"
                    placeholder="Enter your guess"
                    min="1"
                    max="100"
                >


                <button
                    class="guess-button"
                    onclick="makeGuess()">

                    Guess

                </button>


                <p id="guess-message"></p>


                <p>
                    Attempts:
                    <strong id="attempts">
                        0
                    </strong>
                </p>


                <button
                    class="reset-button"
                    onclick="resetGuess()">

                    New Number

                </button>

            </div>

        </section>


        <!-- ================= ABOUT ================= -->

        <section id="about" class="about">

            <p class="badge">
                ABOUT GAMEZONE
            </p>

            <h2>
                Simple games. Zero downloads.
            </h2>

            <p>
                GameZone is a collection of browser
                games built using HTML, CSS and
                JavaScript.
            </p>

        </section>

    </main>


    <!-- ================= FOOTER ================= -->

    <footer>

        <p>
            🎮 GameZone © 2026
        </p>

        <p>
            Built with HTML, CSS & JavaScript
        </p>

    </footer>


    <!-- ================= JAVASCRIPT ================= -->

    <script src="script.js"></script>

</body>
</html>

