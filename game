<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <meta name="description"
          content="GameZone - Free online mini games">

    <title>GameZone - Mini Games</title>

    <style>

        /* =========================
           RESET
        ========================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #080a12;
            color: white;
            min-height: 100vh;
        }

        button,
        input {
            font-family: inherit;
        }

        button {
            cursor: pointer;
        }


        /* =========================
           HEADER
        ========================= */

        header {
            position: sticky;
            top: 0;
            z-index: 1000;

            height: 75px;

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 0 7%;

            background: rgba(8, 10, 18, 0.95);

            border-bottom: 1px solid #252a3a;

            backdrop-filter: blur(12px);
        }

        .logo {
            font-size: 24px;
            font-weight: 800;
            letter-spacing: -0.5px;
        }

        nav {
            display: flex;
            gap: 28px;
        }

        nav a {
            color: #aeb4c7;
            text-decoration: none;
            font-size: 15px;
            transition: 0.2s;
        }

        nav a:hover {
            color: white;
        }


        /* =========================
           HERO
        ========================= */

        .hero {
            min-height: 600px;

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 80px 10%;

            background:
                radial-gradient(
                    circle at 80% 40%,
                    rgba(82, 92, 255, 0.25),
                    transparent 35%
                ),
                radial-gradient(
                    circle at 20% 30%,
                    rgba(30, 90, 150, 0.20),
                    transparent 30%
                );
        }

        .hero-content {
            max-width: 650px;
        }

        .badge {
            display: inline-block;

            color: #8995ff;

            font-size: 13px;
            font-weight: bold;

            letter-spacing: 2px;

            margin-bottom: 20px;
        }

        .hero h1 {
            font-size: clamp(55px, 8vw, 95px);

            line-height: 0.92;

            letter-spacing: -5px;

            margin-bottom: 30px;
        }

        .hero h1 span {
            color: #7480ff;
        }

        .hero-description {
            max-width: 520px;

            color: #9da4b8;

            font-size: 18px;

            line-height: 1.7;

            margin-bottom: 35px;
        }

        .start-button {
            display: inline-block;

            padding: 16px 28px;

            background: #6875ff;

            color: white;

            text-decoration: none;

            border-radius: 12px;

            font-weight: bold;

            transition: 0.25s;
        }

        .start-button:hover {
            transform: translateY(-3px);

            background: #7d88ff;

            box-shadow:
                0 12px 30px rgba(104, 117, 255, 0.25);
        }

        .hero-controller {
            font-size: 180px;

            animation: floating 3s ease-in-out infinite;

            filter:
                drop-shadow(
                    0 0 45px
                    rgba(104, 117, 255, 0.35)
                );
        }

        @keyframes floating {

            0% {
                transform: translateY(0) rotate(0deg);
            }

            50% {
                transform: translateY(-20px) rotate(5deg);
            }

            100% {
                transform: translateY(0) rotate(0deg);
            }

        }


        /* =========================
           GAMES SECTION
        ========================= */

        .games-section {
            padding: 100px 8%;
        }

        .section-heading {
            text-align: center;

            margin-bottom: 55px;
        }

        .section-heading h2 {
            font-size: 45px;

            margin-bottom: 12px;
        }

        .section-heading p:last-child {
            color: #858ca0;
        }

        .game-grid {
            max-width: 1250px;

            margin: auto;

            display: grid;

            grid-template-columns:
                repeat(4, 1fr);

            gap: 22px;
        }

        .game-card {
            padding: 30px;

            min-height: 300px;

            display: flex;
            flex-direction: column;

            background: #131622;

            border: 1px solid #282d40;

            border-radius: 20px;

            transition: 0.3s;
        }

        .game-card:hover {
            transform: translateY(-8px);

            border-color: #6875ff;

            box-shadow:
                0 20px 50px rgba(0, 0, 0, 0.3);
        }

        .game-icon {
            font-size: 52px;

            margin-bottom: 25px;
        }

        .game-card h3 {
            font-size: 21px;

            margin-bottom: 12px;
        }

        .game-card p {
            color: #9299ad;

            line-height: 1.6;

            flex-grow: 1;
        }

        .game-card button {
            width: 100%;

            border: none;

            padding: 13px;

            border-radius: 10px;

            background: #242a40;

            color: white;

            font-weight: bold;

            transition: 0.2s;
        }

        .game-card button:hover {
            background: #6875ff;
        }


        /* =========================
           GAME AREA
        ========================= */

        .game-area {
            min-height: 700px;

            padding: 70px 20px;

            background: #0e111c;

            text-align: center;
        }

        .hidden {
            display: none !important;
        }

        .back-button {
            padding: 11px 18px;

            margin-bottom: 45px;

            border: 1px solid #343a51;

            border-radius: 9px;

            background: transparent;

            color: #b5bbcd;

            transition: 0.2s;
        }

        .back-button:hover {
            background: #1b2030;

            color: white;
        }

        .game-container {
            max-width: 650px;

            margin: auto;
        }

        .game-container h2 {
            font-size: 42px;

            margin-bottom: 12px;
        }

        .game-container > p {
            color: #9ba2b5;

            line-height: 1.6;
        }


        /* =========================
           TIC TAC TOE
        ========================= */

        .board {
            width: 330px;
            height: 330px;

            margin: 30px auto;

            display: grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap: 8px;
        }

        .board button {
            border: 1px solid #30364c;

            border-radius: 12px;

            background: #181c2b;

            color: white;

            font-size: 55px;

            font-weight: bold;

            transition: 0.2s;
        }

        .board button:hover {
            background: #252b41;
        }


        /* =========================
           ROCK PAPER SCISSORS
        ========================= */

        .rps-buttons {
            display: flex;

            justify-content: center;

            flex-wrap: wrap;

            gap: 12px;

            margin-top: 30px;
        }

        .rps-buttons button {
            padding: 16px 22px;

            border: none;

            border-radius: 11px;

            background: #1b2032;

            color: white;

            font-size: 16px;

            transition: 0.2s;
        }

        .rps-buttons button:hover {
            background: #6875ff;

            transform: translateY(-3px);
        }

        .score {
            display: flex;

            justify-content: center;

            gap: 80px;

            margin: 45px 0;
        }

        .score div {
            display: flex;

            flex-direction: column;

            gap: 5px;
        }

        .score strong {
            font-size: 45px;
        }

        .score span {
            color: #858ca0;
        }


        /* =========================
           REACTION GAME
        ========================= */

        #reaction-box {
            max-width: 520px;

            height: 250px;

            margin: 30px auto;

            display: flex;

            align-items: center;
            justify-content: center;

            border-radius: 20px;

            background: #252b42;

            font-weight: bold;

            user-select: none;

            transition: 0.15s;
        }

        #reaction-box:hover {
            background: #2b314b;
        }

        .best-score {
            margin-top: 15px;
        }


        /* =========================
           NUMBER GUESS
        ========================= */

        #guess-input {
            width: 260px;

            padding: 15px;

            margin-top: 25px;

            border: 1px solid #343a52;

            border-radius: 10px;

            outline: none;

            background: #181c2b;

            color: white;

            font-size: 16px;

            text-align: center;
        }

        #guess-input:focus {
            border-color: #6875ff;
        }

        .guess-button {
            padding: 15px 24px;

            margin-left: 7px;

            border: none;

            border-radius: 10px;

            background: #6875ff;

            color: white;

            font-weight: bold;
        }

        .guess-button:hover {
            background: #7d88ff;
        }

        #guess-message {
            margin-top: 30px;

            min-height: 25px;

            color: white !important;

            font-weight: bold;
        }


        /* =========================
           RESET BUTTON
        ========================= */

        .reset-button {
            padding: 13px 22px;

            border: none;

            border-radius: 10px;

            background: #242a40;

            color: white;

            font-weight: bold;

            transition: 0.2s;
        }

        .reset-button:hover {
            background: #6875ff;
        }


        /* =========================
           ABOUT
        ========================= */

        .about {
            max-width: 800px;

            margin: auto;

            padding: 100px 20px;

            text-align: center;
        }

        .about h2 {
            font-size: 40px;

            margin-bottom: 20px;
        }

        .about-description {
            color: #9299ad;

            line-height: 1.7;
        }


        /* =========================
           FOOTER
        ========================= */

        footer {
            display: flex;

            justify-content: space-between;

            padding: 35px 8%;

            border-top: 1px solid #252a3b;

            color: #777f95;

            font-size: 14px;
        }


        /* =========================
           TABLET
        ========================= */

        @media (max-width: 1000px) {

            .game-grid {
                grid-template-columns:
                    repeat(2, 1fr);
            }

            .hero-controller {
                font-size: 130px;
            }

        }


        /* =========================
           PHONE
        ========================= */

        @media (max-width: 650px) {

            header {
                padding: 0 20px;
            }

            nav {
                gap: 14px;
            }

            nav a {
                font-size: 13px;
            }

            .hero {
                min-height: 650px;

                padding: 70px 25px;

                text-align: center;
            }

            .hero-description {
                margin-left: auto;
                margin-right: auto;
            }

            .hero-controller {
                display: none;
            }

            .hero h1 {
                font-size: 60px;

                letter-spacing: -3px;
            }

            .games-section {
                padding: 70px 20px;
            }

            .game-grid {
                grid-template-columns: 1fr;
            }

            .section-heading h2 {
                font-size: 36px;
            }

            .board {
                width: 290px;
                height: 290px;
            }

            #guess-input {
                width: 100%;

                margin-bottom: 10px;
            }

            .guess-button {
                margin-left: 0;

                width: 100%;
            }

            footer {
                flex-direction: column;

                gap: 10px;

                text-align: center;
            }

        }

    </style>
</head>


<body>


    <!-- =========================
         HEADER
    ========================= -->

    <header>

        <div class="logo">
            🎮 GameZone
        </div>

        <nav>
            <a href="#home">Home</a>

            <a href="#games">Games</a>

            <a href="#about">About</a>
        </nav>

    </header>



    <!-- =========================
         MAIN
    ========================= -->

    <main>


        <!-- HERO -->

        <section id="home" class="hero">

            <div class="hero-content">

                <div class="badge">
                    🎮 MINI GAME HUB
                </div>

                <h1>
                    Play.<br>
                    <span>Compete.</span><br>
                    Have Fun.
                </h1>

                <p class="hero-description">

                    Welcome to GameZone!

                    Play quick and fun browser
                    games directly from your browser.

                    No downloads. No installations.
                    Just play.

                </p>

                <a
                    href="#games"
                    class="start-button">

                    Start Playing →

                </a>

            </div>


            <div class="hero-controller">

                🎮

            </div>

        </section>



        <!-- =========================
             GAMES
        ========================= -->

        <section
            id="games"
            class="games-section">


            <div class="section-heading">

                <div class="badge">
                    OUR GAMES
                </div>

                <h2>
                    Choose a Game
                </h2>

                <p>
                    Pick a game and start playing!
                </p>

            </div>


            <div class="game-grid">


                <!-- TIC TAC TOE -->

                <div class="game-card">

                    <div class="game-icon">
                        ⭕
                    </div>

                    <h3>
                        Tic-Tac-Toe
                    </h3>

                    <p>
                        Play the classic game
                        of X's and O's.
                    </p>

                    <button
                        onclick="openGame('tictactoe')">

                        Play Game

                    </button>

                </div>



                <!-- ROCK PAPER SCISSORS -->

                <div class="game-card">

                    <div class="game-icon">
                        ✊
                    </div>

                    <h3>
                        Rock Paper Scissors
                    </h3>

                    <p>
                        Battle against the
                        computer.
                    </p>

                    <button
                        onclick="openGame('rps')">

                        Play Game

                    </button>

                </div>



                <!-- REACTION -->

                <div class="game-card">

                    <div class="game-icon">
                        ⚡
                    </div>

                    <h3>
                        Reaction Test
                    </h3>

                    <p>
                        Test your reaction
                        speed.
                    </p>

                    <button
                        onclick="openGame('reaction')">

                        Play Game

                    </button>

                </div>



                <!-- NUMBER GUESS -->

                <div class="game-card">

                    <div class="game-icon">
                        🔢
                    </div>

                    <h3>
                        Number Guess
                    </h3>

                    <p>
                        Guess the secret number
                        from 1 to 100.
                    </p>

                    <button
                        onclick="openGame('guess')">

                        Play Game

                    </button>

                </div>

            </div>

        </section>



        <!-- =========================
             GAME AREA
        ========================= -->

        <section
            id="game-area"
            class="game-area hidden">


            <button
                class="back-button"
                onclick="closeGame()">

                ← Back to Games

            </button>



            <!-- =========================
                 TIC TAC TOE
            ========================= -->

            <div
                id="tictactoe"
                class="game-container hidden">

                <h2>
                    ⭕ Tic-Tac-Toe
                </h2>

                <p id="ttt-status">
                    Player X's turn
                </p>


                <div class="board">

                    <button onclick="tttMove(0)"></button>

                    <button onclick="tttMove(1)"></button>

                    <button onclick="tttMove(2)"></button>

                    <button onclick="tttMove(3)"></button>

                    <button onclick="tttMove(4)"></button>

                    <button onclick="tttMove(5)"></button>

                    <button onclick="tttMove(6)"></button>

                    <button onclick="tttMove(7)"></button>

                    <button onclick="tttMove(8)"></button>

                </div>


                <button
                    class="reset-button"
                    onclick="resetTTT()">

                    Reset Game

                </button>

            </div>



            <!-- =========================
                 ROCK PAPER SCISSORS
            ========================= -->

            <div
                id="rps"
                class="game-container hidden">

                <h2>
                    ✊ Rock Paper Scissors
                </h2>

                <p id="rps-result">
                    Choose your move!
                </p>


                <div class="rps-buttons">

                    <button
                        onclick="playRPS('rock')">

                        ✊ Rock

                    </button>


                    <button
                        onclick="playRPS('paper')">

                        ✋ Paper

                    </button>


                    <button
                        onclick="playRPS('scissors')">

                        ✌️ Scissors

                    </button>

                </div>


                <div class="score">

                    <div>

                        <strong id="player-score">
                            0
                        </strong>

                        <span>
                            You
                        </span>

                    </div>


                    <div>

                        <strong id="computer-score">
                            0
                        </strong>

                        <span>
                            Computer
                        </span>

                    </div>

                </div>


                <button
                    class="reset-button"
                    onclick="resetRPS()">

                    Reset Game

                </button>

            </div>



            <!-- =========================
                 REACTION TEST
            ========================= -->

            <div
                id="reaction"
                class="game-container hidden">

                <h2>
                    ⚡ Reaction Test
                </h2>

                <p id="reaction-text">
                    Click the box to start.
                </p>


                <div
                    id="reaction-box"
                    onclick="reactionClick()">

                    CLICK ME

                </div>


                <p class="best-score">

                    Best:

                    <strong id="best-reaction">
                        --
                    </strong>

                    ms

                </p>

            </div>



            <!-- =========================
                 NUMBER GUESS
            ========================= -->

            <div
                id="guess"
                class="game-container hidden">

                <h2>
                    🔢 Number Guess
                </h2>

                <p>
                    I'm thinking of a number
                    between 1 and 100.
                </p>


                <input
                    type="number"
                    id="guess-input"
                    min="1"
                    max="100"
                    placeholder="Enter a number"
                >


                <button
                    class="guess-button"
                    onclick="makeGuess()">

                    Guess

                </button>


                <p id="guess-message"></p>


                <p>
                    Attempts:

                    <strong id="attempts">
                        0
                    </strong>
                </p>


                <button
                    class="reset-button"
                    onclick="resetGuess()">

                    New Number

                </button>

            </div>

        </section>



        <!-- =========================
             ABOUT
        ========================= -->

        <section
            id="about"
            class="about">

            <div class="badge">
                ABOUT GAMEZONE
            </div>

            <h2>
                Simple games. Zero downloads.
            </h2>

            <p class="about-description">

                GameZone is a collection of
                fun browser games built using
                HTML, CSS and JavaScript.

            </p>

        </section>

    </main>



    <!-- =========================
         FOOTER
    ========================= -->

    <footer>

        <p>
            🎮 GameZone © 2026
        </p>

        <p>
            Built for the web
        </p>

    </footer>



    <!-- =========================
         JAVASCRIPT
    ========================= -->

    <script>


        /* =========================
           GAME NAVIGATION
        ========================= */

        function openGame(gameName) {

            const gameArea =
                document.getElementById("game-area");

            gameArea.classList.remove("hidden");


            const games =
                document.querySelectorAll(
                    ".game-container"
                );


            games.forEach(function(game) {

                game.classList.add("hidden");

            });


            const selectedGame =
                document.getElementById(gameName);


            if (selectedGame) {

                selectedGame.classList.remove("hidden");

            }


            gameArea.scrollIntoView({
                behavior: "smooth"
            });

        }


        function closeGame() {

            document
                .getElementById("game-area")
                .classList.add("hidden");


            document
                .getElementById("games")
                .scrollIntoView({
                    behavior: "smooth"
                });

        }



        /* =========================
           TIC TAC TOE
        ========================= */

        let tttBoard = [
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            ""
        ];


        let currentPlayer = "X";

        let tttGameOver = false;


        function tttMove(index) {

            if (
                tttBoard[index] !== "" ||
                tttGameOver
            ) {

                return;

            }


            tttBoard[index] =
                currentPlayer;


            updateTTTBoard();


            if (checkTTTWinner()) {

                document
                    .getElementById("ttt-status")
                    .textContent =
                    "🎉 Player " +
                    currentPlayer +
                    " wins!";

                tttGameOver = true;

                return;

            }


            if (!tttBoard.includes("")) {

                document
                    .getElementById("ttt-status")
                    .textContent =
                    "🤝 It's a draw!";

                tttGameOver = true;

                return;

            }


            currentPlayer =
                currentPlayer === "X"
                    ? "O"
                    : "X";


            document
                .getElementById("ttt-status")
                .textContent =
                "Player " +
                currentPlayer +
                "'s turn";

        }


        function updateTTTBoard() {

            const cells =
                document.querySelectorAll(
                    ".board button"
                );


            cells.forEach(
                function(cell, index) {

                    cell.textContent =
                        tttBoard[index];

                }
            );

        }


        function checkTTTWinner() {

            const winningPositions = [

                [0, 1, 2],
                [3, 4, 5],
                [6, 7, 8],

                [0, 3, 6],
                [1, 4, 7],
                [2, 5, 8],

                [0, 4, 8],
                [2, 4, 6]

            ];


            return winningPositions.some(
                function(position) {

                    const a = position[0];

                    const b = position[1];

                    const c = position[2];


                    return (
                        tttBoard[a] !== "" &&
                        tttBoard[a] ===
                        tttBoard[b] &&
                        tttBoard[a] ===
                        tttBoard[c]
                    );

                }
            );

        }


        function resetTTT() {

            tttBoard = [
                "",
                "",
                "",
                "",
                "",
                "",
                "",
                "",
                ""
            ];


            currentPlayer = "X";

            tttGameOver = false;


            updateTTTBoard();


            document
                .getElementById("ttt-status")
                .textContent =
                "Player X's turn";

        }



        /* =========================
           ROCK PAPER SCISSORS
        ========================= */

        let playerScore = 0;

        let computerScore = 0;


        function playRPS(playerChoice) {

            const choices = [
                "rock",
                "paper",
                "scissors"
            ];


            const computerChoice =
                choices[
                    Math.floor(
                        Math.random() *
                        choices.length
                    )
                ];


            let result;


            if (
                playerChoice ===
                computerChoice
            ) {

                result =
                    "🤝 Draw! Both chose " +
                    computerChoice + ".";

            }


            else if (

                (
                    playerChoice === "rock" &&
                    computerChoice === "scissors"
                )

                ||

                (
                    playerChoice === "paper" &&
                    computerChoice === "rock"
                )

                ||

                (
                    playerChoice === "scissors" &&
                    computerChoice === "paper"
                )

            ) {

                playerScore++;


                result =
                    "🎉 You win! Computer chose " +
                    computerChoice + ".";

            }


            else {

                computerScore++;


                result =
                    "😔 Computer wins! It chose " +
                    computerChoice + ".";

            }


            document
                .getElementById("rps-result")
                .textContent = result;


            document
                .getElementById("player-score")
                .textContent =
                playerScore;


            document
                .getElementById("computer-score")
                .textContent =
                computerScore;

        }


        function resetRPS() {

            playerScore = 0;

            computerScore = 0;


            document
                .getElementById("player-score")
                .textContent = "0";


            document
                .getElementById("computer-score")
                .textContent = "0";


            document
                .getElementById("rps-result")
                .textContent =
                "Choose your move!";

        }



        /* =========================
           REACTION TEST
        ========================= */

        let reactionStarted = false;

        let reactionStartTime = 0;

        let reactionTimer = null;


        const reactionBox =
            document.getElementById(
                "reaction-box"
            );


        function startReactionGame() {

            reactionStarted = false;


            reactionBox.textContent =
                "WAIT...";


            reactionBox.style.background =
                "#8c3030";


            const randomDelay =
                Math.floor(
                    Math.random() * 3000
                ) + 1500;


            reactionTimer =
                setTimeout(
                    function() {

                        reactionStarted = true;


                        reactionStartTime =
                            Date.now();


                        reactionBox.textContent =
                            "CLICK!";


                        reactionBox.style.background =
                            "#237044";

                    },
                    randomDelay
                );

        }


        function reactionClick() {

            if (
                !reactionStarted &&
                reactionBox.textContent ===
                "CLICK ME"
            ) {

                startReactionGame();

                return;

            }


            if (!reactionStarted) {

                clearTimeout(
                    reactionTimer
                );


                reactionBox.textContent =
                    "Too early! Click to try again.";


                reactionBox.style.background =
                    "#8c3030";


                return;

            }


            const reactionTime =
                Date.now() -
                reactionStartTime;


            reactionStarted = false;


            reactionBox.textContent =
                reactionTime +
                " ms — Click to try again";


            reactionBox.style.background =
                "#252b42";


            document
                .getElementById(
                    "reaction-text"
                )
                .textContent =
                "Nice! Try to beat your record.";


            const savedBest =
                localStorage.getItem(
                    "bestReaction"
                );


            if (
                !savedBest ||
                reactionTime <
                Number(savedBest)
            ) {

                localStorage.setItem(
                    "bestReaction",
                    reactionTime
                );


                document
                    .getElementById(
                        "best-reaction"
                    )
                    .textContent =
                    reactionTime;

            }

        }



        /* =========================
           NUMBER GUESS
        ========================= */

        let secretNumber =
            Math.floor(
                Math.random() * 100
            ) + 1;


        let guessAttempts = 0;


        function makeGuess() {

            const input =
                document.getElementById(
                    "guess-input"
                );


            const guess =
                Number(input.value);


            if (
                !guess ||
                guess < 1 ||
                guess > 100
            ) {

                document
                    .getElementById(
                        "guess-message"
                    )
                    .textContent =
                    "⚠️ Enter a number between 1 and 100.";

                return;

            }


            guessAttempts++;


            document
                .getElementById(
                    "attempts"
                )
                .textContent =
                guessAttempts;


            if (guess === secretNumber) {

                document
                    .getElementById(
                        "guess-message"
                    )
                    .textContent =
                    "🎉 Correct! You got it in " +
                    guessAttempts +
                    " attempts!";

            }


            else if (guess < secretNumber) {

                document
                    .getElementById(
                        "guess-message"
                    )
                    .textContent =
                    "📈 Too low! Try again.";

            }


            else {

                document
                    .getElementById(
                        "guess-message"
                    )
                    .textContent =
                    "📉 Too high! Try again.";

            }


            input.value = "";

        }


        function resetGuess() {

            secretNumber =
                Math.floor(
                    Math.random() * 100
                ) + 1;


            guessAttempts = 0;


            document
                .getElementById(
                    "attempts"
                )
                .textContent = "0";


            document
                .getElementById(
                    "guess-message"
                )
                .textContent =
                "🎲 New number generated!";


            document
                .getElementById(
                    "guess-input"
                )
                .value = "";

        }



        /* =========================
           ENTER KEY FOR GUESS GAME
        ========================= */

        document
            .getElementById(
                "guess-input"
            )
            .addEventListener(
                "keydown",
                function(event) {

                    if (
                        event.key === "Enter"
                    ) {

                        makeGuess();

                    }

                }
            );



        /* =========================
           LOAD BEST SCORE
        ========================= */

        const savedBest =
            localStorage.getItem(
                "bestReaction"
            );


        if (savedBest) {

            document
                .getElementById(
                    "best-reaction"
                )
                .textContent =
                savedBest;

        }

    </script>

</body>
</html>
